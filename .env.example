# Copy to .env.local (local) and set the same keys in Vercel -> Settings -> Environment Variables (production)

# Owner-only panel (/owner/*) login. If either is missing the panel stays LOCKED.
OWNER_PANEL_USER=owner
OWNER_PANEL_PASSWORD=change-me-to-a-long-random-password

# Public website address printed inside table QR codes (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-cafe-domain.com
